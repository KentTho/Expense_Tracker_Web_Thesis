# Expense Tracker Frontend Environment Variables
# Copy this file to .env and update the values

# API Base URL (Backend endpoint) — ORIGIN ONLY.
# ĐÚNG:  https://api.example.com   |   http://localhost:8000
# SAI:   .../api  hoặc  .../auth  hoặc kèm trailing slash (route đã được ghép trong code).
# Dev mặc định (khi bỏ trống) = http://localhost:8000
VITE_API_URL=http://localhost:8000
